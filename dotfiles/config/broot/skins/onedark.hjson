###############################################################
# One Dark, matching kak/colors/onedark.kak
#
#   red     E06C75  rgb(224, 108, 117)
#   green   98C379  rgb(152, 195, 121)
#   yellow  E5C07B  rgb(229, 192, 123)
#   blue    61AFEF  rgb(97, 175, 239)
#   purple  C678DD  rgb(198, 120, 221)
#   cyan    56B6C2  rgb(86, 182, 194)
#   gold    D19A66  rgb(209, 154, 102)
#   white   ABB2BF  rgb(171, 178, 191)
#   black   282C34  rgb(40, 44, 52)
#   lblack  2C323C  rgb(44, 50, 60)
#   gray    3E4452  rgb(62, 68, 82)
#   lgray   5C6370  rgb(92, 99, 112)
#   linenr  4B5263  rgb(75, 82, 99)
#
# Doc at https://dystroy.org/broot/skins/
###############################################################
skin: {
    default: rgb(171, 178, 191) none / rgb(92, 99, 112) none
    tree: rgb(75, 82, 99) none / rgb(62, 68, 82) none
    parent: rgb(171, 178, 191) none / rgb(92, 99, 112) none
    file: rgb(171, 178, 191) none / rgb(92, 99, 112) none
    directory: rgb(97, 175, 239) none bold / rgb(97, 175, 239) none
    exe: rgb(152, 195, 121) none
    link: rgb(86, 182, 194) none
    pruning: rgb(92, 99, 112) none italic
    perm__: rgb(75, 82, 99) none
    perm_r: rgb(229, 192, 123) none
    perm_w: rgb(224, 108, 117) none
    perm_x: rgb(152, 195, 121) none
    owner: rgb(209, 154, 102) none
    group: rgb(229, 192, 123) none
    count: rgb(86, 182, 194) none
    dates: rgb(92, 99, 112) none
    sparse: rgb(229, 192, 123) none
    content_extract: rgb(171, 178, 191) none
    content_match: rgb(40, 44, 52) rgb(229, 192, 123)
    device_id_major: rgb(209, 154, 102) none
    device_id_sep: rgb(92, 99, 112) none
    device_id_minor: rgb(209, 154, 102) none
    git_branch: rgb(198, 120, 221) none
    git_insertions: rgb(152, 195, 121) none
    git_deletions: rgb(224, 108, 117) none
    git_status_current: rgb(92, 99, 112) none
    git_status_modified: rgb(229, 192, 123) none
    git_status_staged: rgb(152, 195, 121) none
    git_status_new: rgb(152, 195, 121) none bold
    git_status_ignored: rgb(75, 82, 99) none
    git_status_conflicted: rgb(224, 108, 117) none bold
    git_status_other: rgb(224, 108, 117) none
    selected_line: none rgb(62, 68, 82) / none rgb(44, 50, 60)
    char_match: rgb(229, 192, 123) none bold
    file_error: rgb(224, 108, 117) none
    flag_label: rgb(92, 99, 112) rgb(44, 50, 60)
    flag_value: rgb(198, 120, 221) rgb(44, 50, 60) bold
    input: rgb(171, 178, 191) rgb(44, 50, 60) / rgb(92, 99, 112) none
    status_error: rgb(40, 44, 52) rgb(224, 108, 117)
    status_job: rgb(40, 44, 52) rgb(229, 192, 123)
    status_normal: rgb(171, 178, 191) rgb(44, 50, 60) / rgb(92, 99, 112) rgb(44, 50, 60)
    status_italic: rgb(198, 120, 221) rgb(44, 50, 60) italic / rgb(92, 99, 112) rgb(44, 50, 60)
    status_bold: rgb(97, 175, 239) rgb(44, 50, 60) bold / rgb(92, 99, 112) rgb(44, 50, 60)
    status_code: rgb(152, 195, 121) rgb(44, 50, 60) / rgb(92, 99, 112) rgb(44, 50, 60)
    status_ellipsis: rgb(92, 99, 112) rgb(44, 50, 60) / rgb(92, 99, 112) rgb(44, 50, 60)
    purpose_normal: rgb(171, 178, 191) rgb(44, 50, 60)
    purpose_italic: rgb(198, 120, 221) rgb(44, 50, 60) italic
    purpose_bold: rgb(97, 175, 239) rgb(44, 50, 60) bold
    purpose_ellipsis: rgb(92, 99, 112) rgb(44, 50, 60)
    scrollbar_track: rgb(44, 50, 60) none / rgb(40, 44, 52) none
    scrollbar_thumb: rgb(92, 99, 112) none / rgb(62, 68, 82) none
    help_paragraph: rgb(171, 178, 191) none
    help_bold: rgb(97, 175, 239) none bold
    help_italic: rgb(198, 120, 221) none italic
    help_code: rgb(152, 195, 121) rgb(44, 50, 60)
    help_headers: rgb(224, 108, 117) none bold
    help_table_border: rgb(75, 82, 99) none
    preview: rgb(171, 178, 191) none / rgb(92, 99, 112) none
    preview_title: rgb(171, 178, 191) rgb(44, 50, 60) / rgb(92, 99, 112) rgb(44, 50, 60)
    preview_line_number: rgb(75, 82, 99) none
    preview_separator: rgb(62, 68, 82) none
    preview_match: rgb(40, 44, 52) rgb(229, 192, 123)
    diff_line_number: rgb(75, 82, 99) none
    diff_added: rgb(152, 195, 121) rgb(49, 61, 51)
    diff_removed: rgb(224, 108, 117) rgb(66, 45, 52)
    hex_null: rgb(75, 82, 99) none
    hex_ascii_graphic: rgb(171, 178, 191) none
    hex_ascii_whitespace: rgb(152, 195, 121) none
    hex_ascii_other: rgb(209, 154, 102) none
    hex_non_ascii: rgb(224, 108, 117) none
    staging_area_title: rgb(171, 178, 191) rgb(44, 50, 60) / rgb(92, 99, 112) rgb(44, 50, 60)
    mode_command_mark: rgb(40, 44, 52) rgb(97, 175, 239) bold
    good_to_bad_0: rgb(152, 195, 121)
    good_to_bad_1: rgb(152, 195, 121)
    good_to_bad_2: rgb(152, 195, 121)
    good_to_bad_3: rgb(86, 182, 194)
    good_to_bad_4: rgb(86, 182, 194)
    good_to_bad_5: rgb(229, 192, 123)
    good_to_bad_6: rgb(229, 192, 123)
    good_to_bad_7: rgb(209, 154, 102)
    good_to_bad_8: rgb(209, 154, 102)
    good_to_bad_9: rgb(224, 108, 117)
}

# No One Dark syntax theme is bundled; OceanDark (base16-ocean) is closest.
syntax_theme: OceanDark
