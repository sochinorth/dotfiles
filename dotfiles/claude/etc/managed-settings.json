{
  "enabledPlugins": {
    "cc-plugin-you-should-know@builtin": true,
    "idasql@idasql-tools": true
  },
  "extraKnownMarketplaces": {
    "idasql-tools": {
      "source": {
        "source": "github",
        "repo": "allthingsida/idasql-skills"
      },
      "autoUpdate": true
    }
  },
  "switchModelsOnFlag": true,
  "preferredNotifChannel": "ghostty",
