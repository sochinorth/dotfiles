{
  "theme": "custom:go",
  "apiKeyHelper": "cat ~/.claude.go/opencode-go.key",
  "env": {
    "ANTHROPIC_MODEL": "deepseek-v4.1-flash[1m]",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "mimo-v2.6-pro[1m]",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "deepseek-v4.1-flash[1m]",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "claude-haiku-5-5[1m]",
    "CLAUDE_CODE_AUTO_MODE_MODEL": "deepseek-v4.1-flash[1m]",
    "ENABLE_TOOL_SEARCH": "false",
    "CLAUDE_CODE_DISABLE_WORKFLOWS": "1",
    "CLAUDE_CODE_DISABLE_CLAUDE_API_SKILL": "1"
  },
  "permissions": {
    "deny": [
      "ReportFindings",
      "NotebookEdit"
    ]
  },
  "modelPicker": {
    "replaceBuiltInOptions": true,
    "options": [
      {
        "model": "deepseek-v4.1-flash[1m]",
        "label": "DeepSeek V4.1 Flash",
        "description": "1M context, 384k output · chat",
        "behavesAs": "claude-opus-5-5"
      },
      {
        "model": "mimo-v2.6-pro[1m]",
        "label": "MiMo-V2.6-Pro",
        "description": "1.05M context, 131k output · chat",
        "behavesAs": "claude-opus-5-5"
      },
      {
        "model": "glm-5.3[1m]",
        "label": "GLM-5.3",
        "description": "1M context, 131k output · chat",
        "behavesAs": "claude-opus-5-5"
      },
      {
        "model": "claude-haiku-5-5[1m]",
        "label": "Claude Haiku 5.5",
        "description": "1M context, 128k output · anthropic"
      },
      {
        "model": "minimax-m3.1-flash-free[1m]",
        "label": "MiniMax M3.1 Flash Free",
        "description": "1M context, 512k output · chat",
        "behavesAs": "claude-haiku-5-5"
      }
    ]
  }
}
