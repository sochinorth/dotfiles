bindkey '^[[3;5~'	kill-word

alias ls='eza --group-directories-first'
alias ll='eza -l --git --group-directories-first'

alias cat='bat -pp'
alias grep='grep --color=auto'
alias tree='eza --tree'

lk() {
	local dir
	dir=$(walk --fuzzy "$@") && [[ -n $dir ]] && cd -- "$dir"
}

source ~/.config/broot/launcher/bash/br
# kak(), kakbr() and the broot() opener wrapper (kakmux repo, dotfiles/config/kak)
[[ -r ~/.config/kak/shell/kakmux.zsh ]] && source ~/.config/kak/shell/kakmux.zsh

doasedit() {
	emulate -L zsh
	(( $# )) || { print -u2 "usage: doasedit FILE..."; return 2 }
	local f tmp orig rc=0
	for f in "$@"; do
		tmp=$(mktemp --tmpdir --suffix=".${f:t}" doasedit.XXXXXX) || return 1
		orig=$tmp.orig
		{
			if [[ -r $f ]]; then
				cat -- $f > $tmp
			elif [[ -e $f ]]; then
				doas cat -- $f > $tmp || { rc=1; continue }
			fi
			cp -- $tmp $orig
			${=VISUAL:-${EDITOR:-vi}} $tmp || { rc=1; continue }
			[[ $(cksum < $tmp) == $(cksum < $orig) ]] || doas tee -- $f < $tmp > /dev/null || rc=1
		} always {
			rm -f -- $tmp $orig
		}
	done
	return rc
}
alias sudoedit='doasedit'

setopt auto_pushd pushd_ignore_dups pushd_silent
setopt complete_in_word always_to_end
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*:descriptions' format '%F{yellow}-- %d --%f'
zstyle ':completion:*' group-name ''

if [[ -o interactive ]] && command -v fortune >/dev/null; then
	fortune
fi

eval "$(starship init zsh)"

