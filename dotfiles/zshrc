_zinit_update_check() {
	local stamp=~/.cache/zinit-update-check out=~/.cache/zinit-updates

	[[ -s $out ]] && print -P "%F{yellow}zinit updates:%f $(<$out) %F{8}(run zup)%f"

	local -a recent=( ${~stamp}(N.mh-24) )
	(( $#recent )) && return

	{
		mkdir -p ${stamp:h} && touch $stamp
		local d; local -a repos outdated
		for d in ${ZINIT[BIN_DIR]} ${ZINIT[PLUGINS_DIR]}/*(N/); do
			[[ -d $d/.git ]] && repos+=($d)
		done
		for d in $repos; do git -C $d fetch --quiet 2>/dev/null & done
		wait
		for d in $repos; do
			[[ $(git -C $d rev-parse HEAD) != $(git -C $d rev-parse '@{u}' 2>/dev/null) ]] \
				&& outdated+=(${${d:t}//---//})
		done
		if (( $#outdated )); then print -r -- "${(j:, :)outdated}" >| $out; else : >| $out; fi
	} &!
}
_zinit_update_check

zup() { zinit self-update && zinit update --parallel && : >| ~/.cache/zinit-updates }

