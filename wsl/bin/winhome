#!/bin/sh
# winhome: the Windows user's home as a WSL path (/mnt/c/Users/NAME). Asked of
# Windows once (cmd.exe, ~40 ms; interop must be on) and cached after that.
cache=${XDG_CACHE_HOME:-$HOME/.cache}/wsl-winhome
if [ -s "$cache" ]; then cat "$cache"; exit; fi
p=$(cd /mnt/c && /mnt/c/Windows/System32/cmd.exe /d /c 'echo %USERPROFILE%' 2>/dev/null | tr -d '\r')
case $p in
?:\\*) ;;
*) echo "winhome: Windows didn't say where %USERPROFILE% is (WSL interop off?)" >&2; exit 1 ;;
esac
h=$(wslpath -u "$p") || exit 1
mkdir -p "${cache%/*}" && printf '%s\n' "$h" > "$cache"
printf '%s\n' "$h"
