# Arch: [core], [extra]. pacman takes the first that answers.
# Arch's own first: geo picks the nearest of its boxes, fastly is a CDN.
Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch
Server = https://fastly.mirror.pkgbuild.com/$repo/os/$arch
# Long-lived tier 1s, apart from Arch's own (DE, DK, US)
Server = https://ftp.halifax.rwth-aachen.de/archlinux/$repo/os/$arch
Server = https://mirrors.dotsrc.org/archlinux/$repo/os/$arch
Server = https://mirrors.edge.kernel.org/archlinux/$repo/os/$arch
